{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VM: build AE",
      "type": "shell",
      "command": "build-mod",
      "args": ["${workspaceFolderBasename}", "--target", "ae"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "VM: build clean",
      "type": "shell",
      "command": "build-mod",
      "args": ["${workspaceFolderBasename}", "--clean"],
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "unit tests",
      "type": "shell",
      "command": "xmake build er-equipload-tests && xmake run er-equipload-tests",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
